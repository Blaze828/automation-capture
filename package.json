{
  "name": "js-assignment-autocapture",
  "displayName": "JS Assignment AutoCapture",
  "description": "Windows와 macOS에서 JavaScript 과제를 실행하고 실제 VS Code 창을 제출용 이미지로 캡처합니다.",
  "version": "0.7.3",
  "publisher": "Blaze828",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Blaze828/automation-capture.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test out/test/*.test.js",
    "test:integration": "npm run compile && node scripts/integration.cjs",
    "package": "node scripts/package.cjs",
    "vscode:prepublish": "npm run compile",
    "package:windows": "node scripts/package.cjs windows",
    "package:mac": "node scripts/package.cjs mac",
    "package:all": "node scripts/package.cjs all",
    "prepare:runtime": "python scripts/bundle_runtime.py"
  },
  "contributes": {
    "commands": [
      {
        "command": "assignment.startRepl",
        "title": "Assignment: Start REPL"
      },
      {
        "command": "assignment.captureRepl",
        "title": "Assignment: Capture REPL"
      },
      {
        "command": "assignment.captureMultiple",
        "title": "Assignment: Capture Multiple Pages"
      },
      {
        "command": "assignment.stopRun",
        "title": "Assignment: Stop Run"
      },
      {
        "command": "assignment.exportChapterZip",
        "title": "Assignment: Export Chapter ZIP"
      },
      {
        "command": "assignment.runAndCapture",
        "title": "Assignment: Run and Capture",
        "icon": "$(device-camera)"
      },
      {
        "command": "assignment.captureAgain",
        "title": "Assignment: Capture Again"
      },
      {
        "command": "assignment.selectOutputFolder",
        "title": "Assignment: Select Output Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "assignment.openOutputFolder",
        "title": "Assignment: Open Output Folder"
      },
      {
        "command": "assignment.selectImageFormat",
        "title": "Assignment: Select Image Format"
      }
    ],
    "keybindings": [
      {
        "command": "assignment.selectOutputFolder",
        "key": "ctrl+alt+s",
        "mac": "ctrl+alt+s"
      },
      {
        "command": "assignment.startRepl",
        "key": "ctrl+alt+e",
        "mac": "ctrl+alt+e"
      },
      {
        "command": "assignment.captureRepl",
        "key": "ctrl+alt+d",
        "mac": "ctrl+alt+d"
      },
      {
        "command": "assignment.runAndCapture",
        "key": "ctrl+alt+q",
        "when": "!inDebugRepl && !editorReadonly",
        "mac": "ctrl+alt+q"
      },
      {
        "command": "assignment.captureAgain",
        "key": "ctrl+alt+w",
        "mac": "ctrl+alt+w"
      },
      {
        "command": "assignment.stopRun",
        "key": "ctrl+alt+x",
        "mac": "ctrl+alt+x"
      },
      {
        "command": "assignment.captureMultiple",
        "key": "ctrl+alt+a",
        "mac": "ctrl+alt+a"
      },
      {
        "command": "assignment.selectImageFormat",
        "key": "ctrl+alt+f",
        "mac": "ctrl+alt+f"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "assignment.runAndCapture",
          "when": "resourceExtname == .js",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "JS Assignment AutoCapture",
      "properties": {
        "assignment.outputFolder": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "제출 폴더의 절대 경로. 명령으로 선택하면 다음 실행에도 유지됩니다."
        },
        "assignment.nodePath": {
          "type": "string",
          "default": "node",
          "description": "고급 설정: Use Bundled Runtime을 끈 경우 사용할 Node.js 실행 파일 경로."
        },
        "assignment.pythonPath": {
          "type": "string",
          "default": "",
          "description": "고급 설정: Use Bundled Runtime을 끈 경우 사용할 Python 실행 파일 경로."
        },
        "assignment.timeoutSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 86400,
          "description": "실행 제한 시간. 만료 시 계속 실행/중단/수동 캡처를 선택합니다."
        },
        "assignment.captureDelayMs": {
          "type": "number",
          "default": 800,
          "minimum": 200,
          "maximum": 10000,
          "description": "터미널과 편집기 화면 안정화 대기 시간(ms)."
        },
        "assignment.imageFormat": {
          "type": "string",
          "enum": [
            "",
            "png",
            "jpg",
            "webp"
          ],
          "default": "",
          "scope": "window",
          "enumDescriptions": [
            "첫 캡처 때 형식 선택",
            "PNG: 무손실 이미지",
            "JPG: 고화질 압축 이미지",
            "WebP: 무손실 압축 이미지"
          ],
          "description": "저장 이미지 형식. 빈 값이면 첫 캡처 때 선택합니다. Ctrl+Alt+F로 변경할 수 있습니다."
        },
        "assignment.useBundledRuntime": {
          "type": "boolean",
          "default": true,
          "description": "확장에 포함된 Node.js와 Python을 사용합니다. 별도 설치가 필요 없습니다. 끄면 Node Path와 Python Path 설정을 사용합니다."
        }
      }
    }
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "glob": "^14.0.3"
  },
  "dependencies": {
    "archiver": "^8.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.7.2"
  }
}
